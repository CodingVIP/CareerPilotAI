# AI_PROVIDERS: comma-separated provider order. Supported adapters include
# "gemini", "openai-compatible", and "local".
AI_PROVIDER="gemini"
# AI_PROVIDERS="local,openai-compatible,gemini"
# Fallback is disabled by default to avoid silently disclosing sensitive prompts.
# AI_ALLOW_FALLBACK="false"
# AI_MODEL="gemini-3.8-flash"
# AI_TIMEOUT_MS="45000"

# Gemini provider credentials.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenAI-compatible or local provider settings.
# AI_BASE_URL="http://localhost:11434/v1"
# AI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# When set, all non-health API routes require Authorization: Bearer <token>.
# API_AUTH_TOKEN="replace-with-a-long-random-token"

# Clerk managed authentication.
# VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY="sk_test_..."
# CLERK_AUTHORIZED_PARTIES="https://your-app.vercel.app"

# Neon/Postgres via pooled serverless connection.
# DATABASE_URL="postgres://..."
# DB_POOL_MAX="5"

# Vercel Blob private resume storage.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
