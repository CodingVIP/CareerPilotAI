# AI_PROVIDERS: comma-separated provider order. Supported adapters include
# "gemini", "openai-compatible", and "local".
AI_PROVIDER="gemini"
# AI_PROVIDERS="local,openai-compatible,gemini"

# Gemini provider credentials.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenAI-compatible or local provider settings.
# AI_BASE_URL="http://localhost:11434/v1"
# AI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
